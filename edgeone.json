        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=300"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'report-sample' 'sha256-/FPPJRMHVVqH/WKaMuHoWFasEMQ27pxl56joLAzYtc0=' 'sha256-2humPfV0Icp0KWc+1H0tXVlmnF8jpEjCgTc2L4yeniQ=' 'sha256-PGxL0Q0iVqNaRppqvS7timgxF9jZ+vC6CDFJ7nreE9o=' 'sha256-jCh5yHzzbQaOCzTl422iNDU/tOSBFJkUaxvnNiyBPzA=' 'sha256-vFgQhzHmsV0YEpZFaqf3uaWpdFpZFTi3Olce8fgHe/Y='; style-src 'self' 'report-sample'; img-src 'self' data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/css/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icon/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
